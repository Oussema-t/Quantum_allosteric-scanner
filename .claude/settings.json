{
  "permissions": {
    "allow": [
      "Read(**/*.md)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git ls-files *)",
      "Bash(git log *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  }
}
