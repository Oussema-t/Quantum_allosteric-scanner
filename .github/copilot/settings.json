{
  "cli": {
    "interactive": {
      "defaultAllowedTools": [
        // working directly with git commands
        "zsh(git status)",
        "zsh(git status --short)",
        "zsh(git show)",
        "zsh(git branch)",
        "zsh(git diff)",
        "zsh(git ls-files)",
        "zsh(git log)",
        // reading the list of changed files from the source JSON file generated by the repo.vcs.changed-files tool
        "zsh(jq -r '.files[]' .ai/tasks/changed-files.source.json | cat)",
        "zsh(jq '{changedCount: .count, files: .files}' .ai/tasks/changed-files.source.json | cat)",
        "zsh(jq -r 'keys_unsorted | join(",")' .ai/tasks/changed-files.source.json | cat)",
        "zsh(jq -r '.files[]' .ai/tasks/changed-files.source.json | awk -F/ '{print $1\"/\"$2\"/\"$3\"/\"$4\"/\"$5\"/\"$6}' | sort | uniq -c | sort -nr | cat)",
        // working with the repository packaging tools
        "zsh(agents-tools/capability-runner.sh repo.packaging.snapshot)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.classify-staged-files)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.branch-file-list)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.plan-next-commit)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.plan-next-commit --dry-run --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.plan-next-commit --apply --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.plan-next-commit --apply --mode amend --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.plan-next-commit --apply --group)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.validate-plan-coverage)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.validate-plan-coverage --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.validate-plan-coverage --json | cat)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.refine-plan)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.review-plan-rules)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.review-plan-rules --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.review-plan-rules --json | cat)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.review-plan-rules --min-area-group-size 3 --min-commit-size 3 --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.cleanup-plan)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.cleanup-plan --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.cleanup-plan --apply --action archive --scope all --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.cleanup-plan --apply --action delete --scope drafts --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.mr-big-picture)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.mr-big-picture --json)",
        "zsh(agents-tools/capability-runner.sh repo.packaging.mr-big-picture --json | cat)",
        "zsh(agents-tools/capability-runner.sh repo.maintenance.behavior-contract-capture)",
        "zsh(agents-tools/capability-runner.sh repo.maintenance.behavior-contract-capture --json)",
        "zsh(agents-tools/capability-runner.sh repo.maintenance.behavior-contract-capture --json | cat)",
        // working with repository local test execution wrappers
        "zsh(agents-tools/capability-runner.sh repo.test.playwright-local)",
        "zsh(agents-tools/capability-runner.sh repo.test.playwright-local --dry-run)",
        "zsh(agents-tools/capability-runner.sh repo.test.playwright-local --help)",
        // working with the repository version control tools
        "zsh(agents-tools/capability-runner.sh repo.vcs.staged-files)",
        "zsh(agents-tools/capability-runner.sh repo.vcs.changed-files)",
        "zsh(agents-tools/capability-runner.sh repo.vcs.changed-files --scope all --json)",
        "zsh(agents-tools/capability-runner.sh repo.vcs.changed-files --scope all --json | cat)",
        "zsh(agents-tools/capability-runner.sh repo.vcs.changed-files --scope all --json > .ai/tasks/changed-files.source.json)"
      ],
      "defaultDeniedTools": [
        "zsh(git push)",
        "zsh(git reset --hard)",
        "zsh(rm)"
      ]
    }
  }
}