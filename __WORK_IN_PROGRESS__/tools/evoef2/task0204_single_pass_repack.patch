+   and structure-writing code throughout (no new energy function, no new
+   rotamer geometry -- a minimal dispatch change, not a physics change).
+   mode: 0 = greedy (SequenceGenerateInitialSequenceSeed), 1 = random
+   (SequenceGenerateRandomSeed). */
+int SinglePassRepackForSCP(Structure* pStructure,RotamerList* pList,char* deschn,char* programpath,char* prf,char* ss,char* sa,char* phipsi,int mode);
