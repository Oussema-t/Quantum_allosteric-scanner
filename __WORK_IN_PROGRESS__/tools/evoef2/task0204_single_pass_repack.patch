@@ -827,3 +827,31 @@ int SimulatedAnnealingOptimizationForSCP(Structure* pStructure,RotamerList* pLis
 }
 
 
+
+
+/* TASK-0204 (Quantum_allosteric-scanner), added to the vendored EvoEF2
+   source -- see EnergyOptimization.h for the full rationale. Reuses
+   SequenceGenerateInitialSequenceSeed/SequenceGenerateRandomSeed and
+   StructureShowMinEnergyStructure exactly as SimulatedAnnealingOptimization
+   ForSCP (above) does; the only change is that no SA loop runs between
+   seed generation and structure output. */
+int SinglePassRepackForSCP(Structure* pStructure,RotamerList* pList,char* deschn,char* programpath,char* prf,char* ss,char* sa,char* phipsi,int mode){
+  srand((unsigned int)time(NULL));
+  Sequence seed;
+  SequenceCreate(&seed);
+
+  if(mode==0){
+    printf("single-pass repack: greedy (lowest self-energy per site, no pairwise)\n");
+    SequenceGenerateInitialSequenceSeed(pStructure,pList,&seed);
+  }
+  else{
+    printf("single-pass repack: random (uniform-random rotamer per site)\n");
+    SequenceGenerateRandomSeed(&seed,pList);
+  }
+
+  StructureCalcSequenceEnergy(pStructure,&seed,deschn,programpath,prf,ss,sa,phipsi);
+  StructureShowMinEnergyStructure(pStructure,&seed,BEST_STRUCT);
+
+  SequenceDestroy(&seed);
+  return Success;
+}
